    data2T                                 BOOLEAN,
    numViasImpressasRelatorios1T           NumViasImpressasRelatorios,
    numViasImpressasRelatorios2T           NumViasImpressasRelatorios,
    dataSegundoTurno                       DataJE OPTIONAL
}

-- info @1141784; name: rtti (high)
UrnaAplicativo ::= ENUMERATED {
