        FROM ModuloEstadoGeralDefs
    DadoCorrespondencia
        FROM ModuloEstadoGeralUrna
    DataJE
        FROM ModuloTiposEleitorais;

-- info @1141808; name: rtti+infoname (high)
EstadoGeralGap ::= SEQUENCE {
    correspondencias                       SEQUENCE (SIZE(0..10)) OF DadoCorrespondencia,
    appId                                  UrnaAplicativo,
    appAnteriorId                          UrnaAplicativo,
    executadoRED                           BOOLEAN,
    identificadoATUE                       BOOLEAN,
